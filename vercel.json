{
  "buildCommand": "echo 'static site — no build'",
  "installCommand": "echo 'no install'",
  "outputDirectory": ".",
  "trailingSlash": false,
  "functions": {
    "api/selfserve/interview.js": {
      "includeFiles": "mvp/conversation-logic/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/observant/Landing.html" },
    { "source": "/setup", "destination": "/app/SelfServe.html" },
    { "source": "/portal", "destination": "/app/SelfServe.html" },
    { "source": "/thread", "destination": "/app/Thread.html" },
    { "source": "/join", "destination": "/app/Join.html" },
    { "source": "/join/:slug", "destination": "/app/Join.html?product=:slug" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/Landing.html", "destination": "/observant/Landing.html" },
    { "source": "/Landing-v1-panel.html", "destination": "/observant/Landing-v1-panel.html" },
    { "source": "/How-It-Works.html", "destination": "/observant/How-It-Works.html" },
    { "source": "/MCP.html", "destination": "/observant/MCP.html" },
    { "source": "/styles.css", "destination": "/observant/styles.css" },
    { "source": "/how.css", "destination": "/observant/how.css" },
    { "source": "/mcp.css", "destination": "/observant/mcp.css" },
    { "source": "/app.js", "destination": "/observant/app.js" },
    { "source": "/how.js", "destination": "/observant/how.js" },
    { "source": "/mcp.js", "destination": "/observant/mcp.js" }
  ]
}
