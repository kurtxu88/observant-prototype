# Observant prototype — environment variables.
# Set these in Vercel → Settings → Environment Variables. They are SECRETS:
# never commit real values. This file is a placeholder / checklist only.

# Live AI voice interview (ElevenLabs Conversational AI).
# Without it, the deep-mode interview falls back to async text.
ELEVENLABS_API_KEY=
# Optional — a specific ElevenLabs voice; falls back to a default if unset.
ELEVENLABS_VOICE_ID=

# Real email sending (Resend). Without it, emails are composed but not sent.
RESEND_API_KEY=
# Optional — the From address for sent email.
RESEND_FROM=
